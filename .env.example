# Application Environment
APP_ENV=development
APP_NAME=Joblane
APP_DEBUG=true

# Server Configuration
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
WORKER_URL=http://localhost:8001

# Database
DATABASE_URL=postgresql+asyncpg://joblane:joblane@postgres:5432/joblane
DATABASE_TEST_URL=postgresql+asyncpg://joblane:joblane@postgres:5432/joblane_test

# Redis
REDIS_URL=redis://redis:6379/0

# Secret Key
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# Storage (MinIO for development)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=joblane
S3_REGION=us-east-1
S3_SECURE=false

# Email (Mailpit for development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@joblane.local
MAIL_FROM_NAME=Joblane

# AI Provider (None for Phase 0)
AI_PROVIDER=none
AI_API_KEY=

# Rate Limiting
RATE_LIMIT=1000
RATE_LIMIT_WINDOW=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Session Configuration
SESSION_COOKIE_NAME=joblane_session
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax

# Security Headers
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_X_FRAME_OPTIONS=DENY
SECURE_X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=no-referrer-when-downgrade
